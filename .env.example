# ---------------------------------------------------------------------------
# AVA Music Archive - environment variables
# Copy this file to `.env` for local development.  On ParsPack PaaS add these
# keys in the application's Environment Variables / Secret section.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Core
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# Comma separated. In production set your real domain, e.g.
# ALLOWED_HOSTS=avamusic.ir,www.avamusic.ir,my-app.apps.teh1.abrhapaas.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=https://avamusic.ir,https://www.avamusic.ir
SITE_BASE_URL=https://avamusic.ir
ADMIN_URL=admin/

# Database (PostgreSQL is recommended on ParsPack PaaS)
# Option A: explicit values
DB_ENGINE=postgresql
POSTGRES_DB=ava_music
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=my-db.apps.teh1.abrhapaas.com
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
# Option B (takes precedence when set): DATABASE_URL=postgresql://user:pass@host:5432/db
# DATABASE_URL=

# Local development fallback (used when DB_ENGINE is not postgresql)
# DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3

# Media/storage
# On PaaS attach a persistent volume and point MEDIA_ROOT at it.
MEDIA_ROOT=
# Optional S3-compatible object storage (Arvan, MinIO, AWS...)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False

# Email (password reset / contact notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AVA Music <no-reply@avamusic.ir>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
CONTACT_NOTIFICATION_EMAIL=

# Security / production
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
TRUST_PROXY_SSL_HEADER=True

# Upload limits (bytes)
MAX_AUDIO_UPLOAD_SIZE=83886080
MAX_IMAGE_UPLOAD_SIZE=8388608
